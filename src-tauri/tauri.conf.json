{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FF-MediaTool",
  "version": "0.49.0",
  "identifier": "com.ffmediatool.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FF-MediaTool v0.49 Beta",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true,
                "visible": true,
                "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
          "FF-MediaTool.ico"
        ]
  }
}